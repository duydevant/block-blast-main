NEXT_PUBLIC_SITE_URL=http://localhost:3000/
NEXT_PUBLIC_SITE_NAME="Block Puzzle"
NEXT_PUBLIC_PRIMARY_COLOR=

# Firebase — xem docs/firebase-setup-guide.md
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Server only — bí mật, không commit
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Service firebase-deploy tự deploy index/TTL/rules mỗi lần docker compose up (dùng service account trên). 0 = tắt.
FIREBASE_AUTO_DEPLOY=1

# Bí mật tạo seed thử thách hằng ngày — chuỗi ngẫu nhiên dài, không đổi sau khi ra mắt
DAILY_SEED_SECRET=

# Web Push nhắc nhở (tạo khoá: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: hoặc https URL liên hệ cho dịch vụ push; bỏ trống = dùng NEXT_PUBLIC_SITE_URL (nếu https)
VAPID_SUBJECT=
# Cron gọi POST /api/cron/daily-reminders với header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Lịch gọi cron nhắc nhở khi chạy Docker (service `cron`, giờ UTC; mặc định 0 12 * * * = 19:00 giờ VN)
CRON_DAILY_REMINDERS_SCHEDULE=

# Docker (docker-compose.yml): cổng app trong container, cổng + IP mở trên host, tên image
PORT=3000
HOST_PORT=3000
HOST_IP=0.0.0.0
IMAGE_NAME=block-puzzle-web
IMAGE_TAG=latest
