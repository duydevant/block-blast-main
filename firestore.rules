rules_version = '2';

// Phase 01: client không đọc/ghi Firestore trực tiếp.
// Mọi truy cập đi qua API route của Next (Admin SDK, bỏ qua rules) để điểm/thống kê
// chỉ do server ghi sau khi replay. Mở quyền đọc từng collection khi cần (VD leaderboards ở phase 02).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
