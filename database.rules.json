{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now)"
      }
    },
    "duels": {
      "$duelId": {
        ".read": "auth != null",
        "live": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('duels').child($duelId).child('state/host/uid').val() === auth.uid || root.child('duels').child($duelId).child('state/guest/uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['score', 'over']) && newData.child('score').isNumber() && newData.child('score').val() >= 0 && newData.child('over').isBoolean()",
            "score": { ".validate": true },
            "over": { ".validate": true },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
